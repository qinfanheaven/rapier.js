{
  "name": "@kuzi/rapier3d",
  "type": "module",
  "collaborators": [
    "Sébastien Crozet <developer@crozet.re>"
  ],
  "description": "3-dimensional physics engine in Rust - official JS bindings. Compatibility package with inlined webassembly as base64.",
  "version": "0.14.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimforge/rapier.js"
  },
  "files": [
    "*"
  ],
  "main": "rapier.cjs.js",
  "homepage": "https://rapier.rs",
  "types": "rapier.d.ts",
  "sideEffects": [
    "./snippets/*"
  ],
  "keywords": [
    "physics",
    "dynamics",
    "rigid",
    "real-time",
    "joints"
  ],
  "module": "rapier.es.js",
  "exports": {
    ".": {
      "browser": "./rapier.es.js",
      "import": "./rapier.cjs.js",
      "require": "./rapier.cjs.js",
      "types": "./rapier.d.ts"
    }
  }
}